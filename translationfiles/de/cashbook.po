#. TRANSLATORS src/CashbookApp.vue:19
#: cashbook/specialAppInfoFakeDummyForL10nScript.php:2
#: cashbook/specialVueFakeDummyForL10nScript.js:11
msgid "Cashbook"
msgstr "Kassenbuch"

#: cashbook/specialAppInfoFakeDummyForL10nScript.php:3
msgid "Keep the cashbook of your shop or association"
msgstr "Führe das Kassenbuch deines Geschäfts oder Vereins"

#: cashbook/specialAppInfoFakeDummyForL10nScript.php:4
msgid ""
"Keep the cashbook of your shop or association in Nextcloud.\n"
"\n"
"- Create cashbooks in any currency\n"
"- Add income and expenses with reason, text, tax rate, receipt number and "
"receipt date\n"
"- Browse the entries of a cashbook by month, quarter, year or a custom date "
"range, grouped by business day\n"
"- Print the cashbook of a period\n"
"- Import cashbooks exported from the SumUp POS Pro (German version)"
msgstr ""
"Führe das Kassenbuch deines Geschäfts oder Vereins in Nextcloud.\n"
"\n"
"- Lege Kassenbücher in beliebiger Währung an\n"
"- Erfasse Einnahmen und Ausgaben mit Grund, Text, Steuersatz, Belegnummer "
"und Belegdatum\n"
"- Zeige die Einträge eines Kassenbuchs nach Monat, Quartal, Jahr oder einem "
"eigenen Zeitraum an, gruppiert nach Geschäftstag\n"
"- Drucke das Kassenbuch eines Zeitraums\n"
"- Importiere Kassenbücher, die aus SumUp POS Pro (deutsche Version) "
"exportiert wurden"

