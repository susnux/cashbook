{
    "openapi": "3.0.3",
    "info": {
        "title": "cashbook",
        "version": "0.0.1",
        "description": "Nextcloud based Cashbook",
        "license": {
            "name": "AGPL-3.0-or-later"
        }
    },
    "components": {
        "securitySchemes": {
            "basic_auth": {
                "type": "http",
                "scheme": "basic"
            },
            "bearer_auth": {
                "type": "http",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "Cashbook": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "account",
                    "currency",
                    "owner"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "name": {
                        "type": "string"
                    },
                    "account": {
                        "type": "string"
                    },
                    "currency": {
                        "type": "string"
                    },
                    "owner": {
                        "type": "string"
                    }
                }
            },
            "Entry": {
                "type": "object",
                "required": [
                    "id",
                    "balance",
                    "text",
                    "date",
                    "reason",
                    "reference",
                    "tax"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "balance": {
                        "type": "number",
                        "format": "double"
                    },
                    "debit": {
                        "type": "number",
                        "format": "double"
                    },
                    "credit": {
                        "type": "number",
                        "format": "double"
                    },
                    "text": {
                        "type": "string"
                    },
                    "date": {
                        "type": "string"
                    },
                    "reason": {
                        "nullable": true,
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/EntryReason"
                            }
                        ]
                    },
                    "reference": {
                        "type": "string",
                        "nullable": true
                    },
                    "tax": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    }
                }
            },
            "EntryReason": {
                "type": "string",
                "enum": [
                    "day-opening",
                    "day-closing",
                    "correction",
                    "income-bank",
                    "income-sales",
                    "income-misc",
                    "expense-bank",
                    "expense-goods",
                    "expense-salary",
                    "expense-tips",
                    "expense-change",
                    "expense-refund",
                    "expense-misc"
                ]
            },
            "OCSMeta": {
                "type": "object",
                "required": [
                    "status",
                    "statuscode"
                ],
                "properties": {
                    "status": {
                        "type": "string"
                    },
                    "statuscode": {
                        "type": "integer"
                    },
                    "message": {
                        "type": "string"
                    },
                    "totalitems": {
                        "type": "string"
                    },
                    "itemsperpage": {
                        "type": "string"
                    }
                }
            }
        }
    },
    "paths": {
        "/ocs/v2.php/apps/cashbook/api/v1/cashbooks": {
            "get": {
                "operationId": "api-index",
                "summary": "Get all cashbooks of the current user",
                "tags": [
                    "api"
                ],
                "security": [
                    {
                        "bearer_auth": []
                    },
                    {
                        "basic_auth": []
                    }
                ],
