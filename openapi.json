        "/ocs/v2.php/apps/cashbook/api/v1/cashbooks/import": {
            "post": {
                "operationId": "api-import-cashbook",
                "summary": "Import a cashbook from uploaded files",
                "description": "The files need to be uploaded as `files[]` form data.",
                "tags": [
                    "api"
                ],
                "security": [
                    {
                        "bearer_auth": []
                    },
                    {
                        "basic_auth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "import"
                                ],
                                "properties": {
                                    "import": {
                                        "type": "string",
                                        "enum": [
                                            "sumup-pos-pro-de"
                                        ],
                                        "description": "The import format to use"
                                    },
                                    "timezone": {
                                        "type": "string",
                                        "nullable": true,
                                        "default": null,
                                        "description": "The timezone of the dates in the uploaded files (defaults to the timezone of the user)"
                                    }
                                }
                            }
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "OCS-APIRequest",
                        "in": "header",
                        "description": "Required to be true for the API request to pass",
                        "required": true,
                        "schema": {
                            "type": "boolean",
                            "default": true
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Cashbook imported",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "ocs"
                                    ],
                                    "properties": {
                                        "ocs": {
                                            "type": "object",
                                            "required": [
